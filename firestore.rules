rules_version = '2';

// Proposed rules for Infinite Meal.
// All writes now go through Next.js API routes using the Admin SDK, which
// bypasses these rules. The browser only needs to read custom_recipes.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin-curated recipes: anyone can read, nobody can write from a browser.
    match /custom_recipes/{id} {
      allow read: if true;
      allow write: if false;
    }

    // AI suggestions awaiting review: server only.
    match /pending_recipes/{id} {
      allow read, write: if false;
    }

    // Rate limiter counters: server only.
    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
