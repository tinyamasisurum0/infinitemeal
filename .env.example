# Gemini (server only)
API_KEY=
# Optional: override the Gemini model (default gemini-3.6-flash)
GEMINI_MODEL=

# Admin panel login
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: separate key for signing admin session cookies (falls back to ADMIN_PASSWORD).
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Firebase Admin SDK service account JSON (raw or base64). Required for admin
# writes, pending-recipe submissions and the shared rate limiter.
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# Optional rate limits for /api/generate-recipe
AI_RATE_PER_MINUTE=10
AI_RATE_PER_DAY=200
AI_GLOBAL_PER_DAY=5000
